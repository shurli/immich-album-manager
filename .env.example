# Immich server. /api may be included or omitted.
# Same Docker network example: http://immich_server:2283
# Host example: http://host.docker.internal:2283
IMMICH_URL=http://host.docker.internal:2283

# Browser-reachable Immich base URL used when clicking an album thumbnail.
# Especially important when IMMICH_URL is an internal Docker hostname.
# If omitted, it is derived from IMMICH_URL.
IMMICH_PUBLIC_URL=https://photos.example.com

IMMICH_API_KEY=replace-with-api-key

# Optional but recommended if the app is reachable by other devices.
APP_USERNAME=admin
APP_PASSWORD=change-me

REQUEST_TIMEOUT_MS=30000
MERGE_PAGE_SIZE=1000
MERGE_CHUNK_SIZE=1000
MERGE_SOURCE_CONCURRENCY=3

# Exact newest/oldest item lookup per album.
# Limits parallel Search API requests and caches results to keep large album lists responsive.
EXTREMA_CONCURRENCY=6
EXTREMA_CACHE_TTL_MS=120000
